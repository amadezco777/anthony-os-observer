# URL base de tu instancia de Jira Cloud (sin slash final)
JIRA_BASE_URL=https://tu-dominio.atlassian.net

# Email de la cuenta de Jira Cloud usada para autenticarse
JIRA_EMAIL=tu-email@ejemplo.com

# API Token generado en https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=tu_api_token

# Ventana en horas para considerar una tarea "actualizada recientemente" (opcional, default 24)
JIRA_RECENT_HOURS=24

# Token del bot de Telegram, obtenido con @BotFather
TELEGRAM_BOT_TOKEN=tu_bot_token

# Chat ID de Telegram donde se enviará el resumen diario
TELEGRAM_CHAT_ID=tu_chat_id
